# Copy to .env.evolution (never commit the copy).
#
# Global API key for the Evolution server. wacrm sends it on every call;
# put the SAME value in wacrm's .env.local as EVOLUTION_API_KEY.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTHENTICATION_API_KEY=change-me

# Password for Evolution's own Postgres container (not Supabase).
# Used by docker-compose.evolution.yml for both the database and the
# API's connection string.
EVOLUTION_DB_PASSWORD=change-me

# Public URL of the Evolution server itself (used in links it generates).
SERVER_URL=http://localhost:8080
